# ====================================================================
# AI Study Companion - Environment Configuration Example
# ====================================================================
# IMPORTANT:
# - Do NOT commit your real API keys or secrets to version control.
# - Copy this file to .env in your root and/or backend directory:
#     copy .env.example .env
# ====================================================================

# GutsAI Gateway Configuration
# Obtain your key starting with 'sk-guts-...' from https://gutsai.id/console
GUTS_API_KEY=
GUTSAI_BASE_URL=https://api.gutsai.id/v1
GUTSAI_DEFAULT_MODEL=claude-sonnet-4.5
GUTSAI_TIMEOUT_SECONDS=60
GUTSAI_MAX_RETRIES=2

# Application Environment & Security
APP_ENV=development
APP_DEBUG=true
AUTH_SECRET=your-secure-random-32-byte-hex-string-for-jwt-signing
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For local development without PostgreSQL, SQLite is used seamlessly by default:
# DATABASE_URL=sqlite:///./study_companion.db
# For PostgreSQL with pgvector in production:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_study_companion
DATABASE_URL=sqlite:///./study_companion.db

# Storage Configuration
# Local storage directory or S3/Supabase storage bucket name:
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=study-companion-storage

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting & Limits
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=25


# Google API Login 
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
